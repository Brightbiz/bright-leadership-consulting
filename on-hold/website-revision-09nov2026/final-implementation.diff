diff --git a/src/hooks/useEnquiryAnchor.ts b/src/hooks/useEnquiryAnchor.ts
new file mode 100644
index 0000000..5b48dcd
--- /dev/null
+++ b/src/hooks/useEnquiryAnchor.ts
@@ -0,0 +1,17 @@
+import { useEffect } from "react";
+import { useLocation } from "react-router-dom";
+
+/** Focus only the explicitly requested section after its route has mounted. */
+export function useEnquiryAnchor(id: string) {
+  const { hash, pathname, search } = useLocation();
+  useEffect(() => {
+    if (hash !== `#${id}`) return;
+    const frame = requestAnimationFrame(() => {
+      const target = document.getElementById(id);
+      if (!target) return;
+      target.focus({ preventScroll: true });
+      target.scrollIntoView({ block: "start", behavior: "instant" });
+    });
+    return () => cancelAnimationFrame(frame);
+  }, [hash, pathname, search, id]);
+}
\ No newline at end of file
